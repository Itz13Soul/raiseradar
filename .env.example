# Copy to .env.local and fill in. Never commit .env.local.

# LLM wrapper: gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Set to a model your key can access (check Google AI Studio). Not hard-coded on purpose.
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase (personal project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ingest job. Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Comma-separated RSS/Atom feed URLs. ONLY add feeds whose terms permit reuse (see README).
FEED_URLS=
# Max items processed per ingest run (keeps free-tier LLM limits safe)
MAX_ITEMS_PER_RUN=8

# One line about YOU, used to tailor the outreach note (e.g. "Founder's Office / strategy candidate, built X").
OUTREACH_SENDER_PITCH=
